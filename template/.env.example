# Where peachy daemon answers (its -listen).
PEACHY_DAEMON_URL=http://127.0.0.1:8080
# The daemon's -token, if it has one.
PEACHY_TOKEN=
# The {number} in the daemon's paths. The daemon doesn't check it; the bot's
# phone number is a good choice.
PEACHY_ACCOUNT=bot
# websocket (hears each message as it arrives) or poll.
PEACHY_RECEIVE=websocket
# With poll: milliseconds between asks.
PEACHY_POLL_MS=1000
# What the bot calls itself in /help.
BOT_NAME=Example Bot
